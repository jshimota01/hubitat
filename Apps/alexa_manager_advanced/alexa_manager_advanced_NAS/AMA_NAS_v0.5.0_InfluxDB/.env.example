AMA_API_KEY=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET
PUBLIC_BASE_URL=https://alexa.e-wiz.com
# OAuth login credentials; set unique values before enabling account linking.
OAUTH_USERNAME=REPLACE_WITH_LOGIN_NAME
OAUTH_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
# Leave empty until the exact Amazon redirect hostnames are confirmed.
OAUTH_CLIENT_ID=
OAUTH_ALLOWED_REDIRECT_HOSTS=

# Optional direct NAS-to-InfluxDB 2.x reporting. Keep disabled until the test write succeeds.
INFLUX_ENABLED=false
INFLUX_URL=http://192.168.1.12:8086
INFLUX_ORG=DundeeHome
INFLUX_BUCKET=HubAlexa
INFLUX_TOKEN=PASTE_AMA_NAS_WRITER_TOKEN_HERE
